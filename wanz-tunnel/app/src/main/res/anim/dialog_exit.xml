<?xml version="1.0" encoding="utf-8"?>
<!-- Dialog keluar persis Material 3 pada acuan: memudar saja selama 150ms
     (m3_sys_motion_duration_short3) dengan easing emphasized accelerate. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@interpolator/m3_emphasized_accelerate"
    android:shareInterpolator="true">
    <alpha
        android:duration="150"
        android:fromAlpha="1.0"
        android:toAlpha="0.0" />
</set>
