<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="@color/b6" android:endColor="@android:color/transparent" android:angle="0.0" android:type="radial" android:gradientRadius="200.0%p" />
            <corners android:radius="2.0dip" />
            <stroke android:width="3.0px" android:color="@color/b6" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="@color/b8" android:endColor="@color/b8" android:angle="0.0" />
            <corners android:radius="2.0dip" />
            <stroke android:width="3.0px" android:color="@color/b6" />
        </shape>
    </item>
</selector>