<?xml version="1.0" encoding="utf-8"?>
<layer-list android:opacity="opaque"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient android:startColor="@color/b9" android:endColor="@color/b8" android:angle="90.0" android:centerColor="@color/b8" />
        </shape>
    </item>
    <item>
        <bitmap android:gravity="center" android:src="@mipmap/a" android:tileMode="disabled" />
    </item>
    <item android:top="90.0dip">
        <bitmap android:gravity="center" android:src="@mipmap/b" android:tileMode="disabled" />
    </item>
</layer-list>